# ======================================
# Server Configuration
# ======================================
PORT=3000
NODE_ENV=development

# CORS Origin (쉼표로 구분하여 여러 도메인 지정 가능)
# 개발: http://localhost:5173
# 프로덕션 (Render): https://your-app-name.onrender.com
CORS_ORIGIN=http://localhost:5173

# Supabase Configuration (Common)
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Frontend Supabase (VITE_ prefix for client-side)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ======================================
# API Configuration (Frontend)
# ======================================
# 개발: http://localhost:3000
# 프로덕션 (Render): https://your-app-name.onrender.com
# 같은 도메인이면 빈 문자열로 두어도 됨
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000

# JWT Secret (Server)
JWT_SECRET=your-jwt-secret-key

# TURN Server Configuration (optional)
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Toss Payments Configuration
# 결제창 API 클라이언트 키 (test_ck로 시작, 실제 금액 이동 없음)
VITE_TOSS_CLIENT_KEY=test_ck_your_client_key_here
# 백엔드 시크릿 키 (테스트용)
TOSS_SECRET_KEY=test_sk_your_secret_key_here

# ======================================
# Render 배포 설정 가이드
# ======================================
# 1. Render 대시보드에서 New Web Service 생성
# 2. GitHub 레포지토리 연결
# 3. 아래 설정 적용:
#    - Build Command: npm install && npm run build:client
#    - Start Command: npm start
# 4. Environment Variables 설정:
#    - NODE_ENV=production
#    - CORS_ORIGIN=https://your-app-name.onrender.com
#    - VITE_API_URL=https://your-app-name.onrender.com
#    - VITE_SOCKET_URL=https://your-app-name.onrender.com
#    - (나머지 Supabase, JWT, Toss 키 설정)
#
# 배포 URL: https://your-app-name.onrender.com
# Health Check: /health
