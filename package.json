{
  "name": "verseup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/server.js",
    "dev:both": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "build:client": "vite build",
    "build:server": "echo 'No TypeScript compilation needed'",
    "preview": "vite preview",
    "start": "node server/server.js",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write \"{src,server}/**/*.{js,jsx,json,css,md}\"",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:push": "supabase db push",
    "supabase:db:pull": "supabase db pull",
    "supabase:migration:new": "supabase migration new",
    "supabase:gen:types": "supabase gen types typescript --local > src/types/database.types.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/rapier": "^2.2.0",
    "@supabase/supabase-js": "^2.83.0",
    "@tanstack/react-query": "^5.90.10",
    "@tosspayments/tosspayments-sdk": "^2.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "framer-motion": "^12.23.24",
    "jsonwebtoken": "^9.0.2",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.6",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.181.2",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "supabase": "^2.65.6",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
